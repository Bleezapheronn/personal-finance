{
  "name": "personal-finance",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:selected-read-imports": "node scripts/check-selected-read-imports.mjs",
    "check:no-runtime-artifacts": "node scripts/check-no-runtime-artifacts.mjs",
    "check:local-api-safety": "node scripts/check-local-api-safety.mjs",
    "backup:ops": "node server/node_modules/tsx/dist/cli.mjs server/src/backupOps.ts",
    "restore:ops": "node server/node_modules/tsx/dist/cli.mjs server/src/restoreOps.ts",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint",
    "desktop:package": "node desktop/scripts/build-internal.mjs",
    "desktop:proof": "node desktop/test/run-packaged-proof.mjs"
  },
  "dependencies": {
    "@capacitor/app": "7.1.0",
    "@capacitor/core": "7.4.4",
    "@capacitor/haptics": "7.0.2",
    "@capacitor/keyboard": "7.0.3",
    "@capacitor/status-bar": "7.0.3",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "better-sqlite3": "12.11.1",
    "dexie": "^4.2.1",
    "fastify": "5.4.0",
    "ionicons": "^7.4.0",
    "react": "19.0.0",
    "react-datepicker": "^8.8.0",
    "react-dom": "19.0.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.4",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.1",
    "cypress": "^13.5.0",
    "electron": "44.2.0",
    "electron-builder": "26.16.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "terser": "^5.4.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.24.0",
    "vite": "~5.2.0",
    "vitest": "^0.34.6"
  },
  "overrides": {
    "rollup": "4.44.0"
  },
  "description": "An Ionic project",
  "build": {
    "appId": "com.bleezapheronn.personalfinance",
    "productName": "Personal Finance",
    "directories": {
      "output": "release-internal"
    },
    "files": [
      "dist/**",
      "desktop/main.mjs",
      "desktop/preload.mjs",
      "desktop-dist/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "publish": null
  }
}
