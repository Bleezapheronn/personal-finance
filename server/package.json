    "test:budget-delete": "tsx src/testBudgetDelete.ts",
    "test:recipient-lifecycle": "tsx src/testRecipientLifecycle.ts",
    "test:account-lifecycle": "tsx src/testAccountLifecycle.ts",
    "test:account-images": "tsx src/testAccountImages.ts",
    "test:account-image-mutation": "tsx src/testAccountImageMutation.ts",
    "test:account-image-mutation-api": "tsx src/testAccountImageMutationApi.ts",
    "test:category-lifecycle": "tsx src/testCategoryLifecycle.ts",
    "test:bucket-lifecycle": "tsx src/testBucketLifecycle.ts",
    "test:management-lifecycle-writes": "tsx src/testManagementLifecycleWrites.ts",
    "verify:sqlite": "tsx src/verifySqlitePrototype.ts",
    "smoke:api": "tsx src/smokeApi.ts",
    "token:show": "tsx src/tokenCli.ts show",
    "token:rotate": "tsx src/tokenCli.ts rotate"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
