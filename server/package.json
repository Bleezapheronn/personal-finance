{
  "name": "personal-finance-local-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local SQLite API for Personal Finance.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "runtime:start": "tsx src/runtimeServer.ts",
    "import:backup": "tsx src/importBackup.ts",
    "hydrate:account-images": "tsx src/hydrateAccountImages.ts",
    "compare:counts": "tsx src/compareBackupSqlite.ts",
    "compare:integrity": "tsx src/compareIntegrity.ts",
    "compare:financial": "tsx src/compareFinancialAggregates.ts",
    "compare:reports": "tsx src/compareReportTotals.ts",
    "compare:transactions": "tsx src/compareTransactionSamples.ts",
    "compare:budget-history": "tsx src/compareBudgetHistory.ts",
    "compare:budget-snapshot-generation": "tsx src/compareBudgetSnapshotGeneration.ts",
    "backup:sqlite": "tsx src/backupSqlite.ts",
    "restore:sqlite": "tsx src/restoreSqlite.ts",
    "backup:ops": "tsx src/backupOps.ts",
    "test:automatic-backups-api": "tsx src/testAutomaticBackupsApi.ts",
    "test:scheduled-sqlite-backup": "tsx src/testScheduledSqliteBackup.ts",
    "test:runtime-launcher": "npm run build && node dist/testRuntimeLauncher.js",
    "test:sqlite-backup-restore": "tsx src/testSqliteBackupRestore.ts",
    "test:transaction-delete": "tsx src/testTransactionDelete.ts",
    "test:transaction-description-prefill": "tsx src/testTransactionDescriptionPrefill.ts",
    "test:budget-lifecycle": "tsx src/testBudgetLifecycle.ts",
    "test:budget-snapshot-occurrence": "tsx src/testBudgetSnapshotOccurrence.ts",
    "test:budget-occurrence-batch": "tsx src/testBudgetOccurrenceBatch.ts",
